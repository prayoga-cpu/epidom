// =============================================================================
// PHASE 4: OPERATIONS LAYER
// =============================================================================

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
}

// Operational team split for reporting — deliberately separate from the
// free-text `category` field (which stores use for arbitrary grouping like
// supplier origin or menu display sections).
// BOTH only applies to Material — a raw ingredient (e.g. sugar, ice) can be
// consumed by both stations, unlike a Product/MenuItem/Recipe, each of which
// is a single preparation routed to exactly one KDS station.
enum Department {
  KITCHEN
  BAR
  BOTH
}

enum PayType {
  HOURLY
  MONTHLY
  NONE
}

model StaffMember {
  id              String         @id @default(cuid())
  storeId         String
  name            String
  // Login identity for the staff PIN gate — unique per store (not globally),
  // nullable so existing rows created before this field don't need backfilling.
  username        String?
  // Contact details only — no longer used as a login identifier.
  email           String?
  whatsapp        String?
  role            StaffRole      @default(CASHIER)
  // Optional display label shown instead of the role's default title (e.g.
  // "Assistant Manager") — the `role` field still drives the default page
  // template below; the owner refines actual access via allowedPages.
  customRoleLabel String?
  // Which dashboard pages (nav item hrefs, e.g. "/pos", "/staff") this staff
  // member can reach. Empty = inherit the role's default template (see
  // ROLE_DEFAULT_PAGES in staff-permissions.config.ts) — resolved dynamically
  // so existing rows don't need backfilling and stay in sync if a role
  // template default ever changes.
  allowedPages    String[]       @default([])
  pin             String? // bcrypt hash — optional
  // Optional pay rate for labor-cost reporting — hours come from
  // AttendanceRecord/Shift timestamps, cost is hours × payRate for HOURLY,
  // or a flat payRate/period for MONTHLY. NONE (default) means no rate is
  // set (many roles are genuinely off-system payroll); reports must treat
  // NONE as "unknown," not zero.
  payType         PayType        @default(NONE)
  payRate         Decimal?       @db.Decimal(12, 2)
  isActive        Boolean        @default(true)
  inviteStatus    String? // "pending" | "accepted" | null
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shifts          Shift[]
  sessions        StaffSession[]
  staffSchedules    StaffSchedule[]
  attendanceRecords AttendanceRecord[]

  @@unique([storeId, username])
  @@index([storeId])
  @@map("staff_members")
}

/// A server-verified "this browser is currently operating as this staff
/// member" session, established when a staff PIN is verified. Distinct from
/// better-auth's Session (which always belongs to the account owner) — this
/// is what lets owner-only pages (Profile, Billing, Staff) tell a restricted
/// staff persona apart from the real owner and block access server-side.
model StaffSession {
  id            String      @id @default(cuid())
  storeId       String
  staffMemberId String
  token         String      @unique
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([staffMemberId])
  @@map("staff_sessions")
}

model Shift {
  id             String      @id @default(cuid())
  storeId        String
  staffMemberId  String
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  openingCash    Decimal     @db.Decimal(12, 2)
  closingCash    Decimal?    @db.Decimal(12, 2)
  expectedCash   Decimal?    @db.Decimal(12, 2) // calculated from orders
  cashDifference Decimal?    @db.Decimal(12, 2) // closingCash - expectedCash
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  store          Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffMember    StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([storeId])
  @@index([staffMemberId])
  @@index([openedAt])
  @@map("shifts")
}

// =============================================================================
// STAFF SCHEDULING, HOURS & SELFIE ATTENDANCE (proposed addition, see
// docs/roadmap.md) — a parallel domain from `Shift` above, which is a POS
// cash-drawer till session (mandatory openingCash, realistically cashier-only).
// These models track planned rosters and actual clock-in/out for every role.
// =============================================================================

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

enum AttendanceType {
  CLOCK_IN
  CLOCK_OUT
  ABSENCE
}

// A reusable named time-block template per store (e.g. "Shift 1" 08:00–16:00),
// picked from a dropdown when building a roster instead of retyping times
// every time. Blocks may legitimately overlap (staggered handover coverage)
// — see StaffSchedule and the Finance by-schedule-shift report.
model ScheduleShift {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  // Plain "HH:mm" strings — there's no calendar date at the template level,
  // only once applied to a StaffSchedule row on a specific date. endTime may
  // be numerically <= startTime, meaning the block crosses midnight (e.g.
  // "20:00" -> "04:00").
  startTime String
  endTime   String
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  schedules StaffSchedule[]

  @@unique([storeId, name])
  @@index([storeId])
  @@map("schedule_shifts")
}

// One roster assignment: a staff member working a given date, either a named
// ScheduleShift block or a custom one-off time range. No uniqueness
// constraint on (staffMemberId, date) — a split shift is legitimately two
// rows for the same staff/date.
model StaffSchedule {
  id              String         @id @default(cuid())
  storeId         String
  staffMemberId   String
  date            DateTime       @db.Date
  scheduleShiftId String?
  customStartTime String?
  customEndTime   String?
  // A day off for this staff member on this date — mutually exclusive with
  // scheduleShiftId/customStartTime+customEndTime (enforced in Zod, not the
  // DB, same approach as the block-vs-custom-time choice above).
  isDayOff        Boolean        @default(false)
  department      Department?
  notes           String?
  status          ScheduleStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffMember     StaffMember       @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  scheduleShift   ScheduleShift?    @relation(fields: [scheduleShiftId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([storeId, date])
  @@index([staffMemberId])
  @@index([scheduleShiftId])
  @@map("staff_schedules")
}

// One clock event (clock-in, clock-out, or a reported absence). No DB-level
// "one open clock-in" constraint, same precedent as Shift — enforced at the
// app layer. Corrections never edit/delete a record — see the manager
// "close" endpoint, which appends a new CLOCK_OUT instead.
model AttendanceRecord {
  id              String         @id @default(cuid())
  storeId         String
  staffMemberId   String
  staffScheduleId String?
  type            AttendanceType
  timestamp       DateTime       @default(now())
  // Required by app-layer validation for CLOCK_IN/CLOCK_OUT, not required
  // for ABSENCE — the DB stays permissive since the requirement differs by
  // `type`, enforced in the Zod schema instead.
  selfieUrl       String?
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  // Best-effort reverse-geocoded label — never blocks a clock-in/out if the
  // lookup fails or times out.
  locationLabel   String?
  notes           String?
  createdAt       DateTime       @default(now())
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffMember     StaffMember    @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  staffSchedule   StaffSchedule? @relation(fields: [staffScheduleId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([staffMemberId, timestamp])
  @@index([staffScheduleId])
  @@map("attendance_records")
}

