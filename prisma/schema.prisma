generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
  output   = "./dbml"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  emailVerified          Boolean
  image                  String?
  createdAt              DateTime
  updatedAt              DateTime
  // Custom fields
  phone                  String?
  locale                 String    @default("id")
  timezone               String    @default("Asia/Jakarta")
  // Set only when TimezoneSync actually persists a browser-detected zone —
  // lets the admin panel tell a real "Asia/Jakarta" user apart from an
  // account that never loaded an authenticated page (still on the raw
  // schema default) instead of guessing from the value alone.
  timezoneUpdatedAt      DateTime?
  currency               String    @default("IDR")
  defaultLanding         String    @default("dashboard")
  stripeConnectAccountId String?
  stripeConnectOnboarded Boolean   @default(false)
  isAdmin                Boolean   @default(false)
  hasOnboarded           Boolean   @default(false)
  // Set when the owner self-deactivates (or an admin does so on their behalf).
  // Self-service reactivation is allowed for 30 days after this; after that,
  // recovery requires a support-quoted fee up until purgeAt.
  deactivatedAt          DateTime?
  // deactivatedAt + 365 days. The daily purge job hard-deletes the account
  // once this passes — retention is only guaranteed for 12 months.
  purgeAt                DateTime?

  sessions                  Session[]
  accounts                  Account[]
  alerts                    Alert[]
  feedback                  Feedback[]
  customDevelopmentRequests CustomDevelopmentRequest[]
  business                  Business?
  subscription              Subscription?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Business {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  name            String
  address         String?
  city            String?
  country         String?
  phone           String?
  email           String?
  logo            String?
  website         String?
  currency        String                   @default("IDR")
  timezone        String                   @default("Asia/Jakarta")
  locale          String                   @default("id")
  // bcrypt hash of the owner's 4-digit PIN. Required once any StaffMember
  // exists, so a shared device can gate "switch back to Owner" behind
  // something only the real owner knows (staff never see this PIN).
  ownerPin        String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores          Store[]
  financeSettings BusinessFinanceSettings?

  @@map("businesses")
}

model Store {
  id                      String                 @id @default(cuid())
  businessId              String
  name                    String
  address                 String?
  city                    String?
  country                 String?
  phone                   String?
  email                   String?
  image                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  ingredients             Material[]
  orders                  Order[]
  productionBatches       ProductionBatch[]
  products                Product[]
  recipes                 Recipe[]
  business                Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierOrders          SupplierOrder[]
  suppliers               Supplier[]
  aiImportMemories        AIImportMemory[]
  aiImportSessions        AIImportSession[]
  storefront              Storefront?
  tables                  Table[]
  staffMembers            StaffMember[]
  shifts                  Shift[]
  reservations            Reservation[]
  aggregatorConnections   AggregatorConnection[]
  aggregatorEmails        AggregatorEmail[]
  financeSettings         StoreFinanceSettings?
  staffSessions           StaffSession[]
  wasteEntries            WasteEntry[]
  pushSubscriptions       PushSubscription[]
  receiptSettings         StoreReceiptSettings?
  // When true, this store's fees & taxes are read from Business.financeSettings
  // instead of its own StoreFinanceSettings row (a shared, profile-wide config).
  syncFinanceWithBusiness Boolean                @default(false)
  // Owner-only toggle: when true, cashiers can select "Pay Later" at checkout
  // so an order is served now and settled after delivery. Deliberately a
  // plain per-store flag (not part of the finance sync above) — a business
  // may want tabs allowed at one outlet but not another.
  payLaterEnabled         Boolean                @default(false)
  // Owner-only toggle, defaults on (existing stores keep today's behavior).
  // When false, orders skip the kitchen/bar production stages entirely —
  // once payment is recorded they go straight to DELIVERED, for small
  // operations (e.g. a counter-only coffee stand) that have no kitchen
  // workflow to track.
  kitchenDisplayEnabled   Boolean                @default(true)
  // Owner-only toggle, defaults off. Recipe-to-batch production tracking is
  // a distinct manufacturing workflow (plan a batch from a recipe, consume
  // materials, produce finished product) that not every merchant needs —
  // many cook fresh to order with no fixed recipe. Off by default so the
  // Production nav page shows a guide/explainer instead of the workflow
  // until the owner opts in.
  productionEnabled       Boolean                @default(false)
  // Daily overtime threshold, in minutes, used by the Attendance "Hours &
  // Overtime" report — worked minutes beyond this per calendar day count as
  // overtime. Flat per-store value (no per-role/per-shift threshold in v1).
  standardWorkMinutesPerDay Int                  @default(480)
  scheduleShifts          ScheduleShift[]
  staffSchedules          StaffSchedule[]
  attendanceRecords       AttendanceRecord[]

  @@index([businessId])
  @@map("stores")
}

model StoreFinanceSettings {
  id      String @id @default(cuid())
  storeId String @unique

  taxEnabled   Boolean @default(false)
  taxRate      Decimal @default(0) @db.Decimal(6, 4) // 0.1100 = 11%
  taxLabel     String?
  taxInclusive Boolean @default(true)

  serviceChargeEnabled Boolean @default(false)
  serviceChargeRate    Decimal @default(0) @db.Decimal(6, 4)

  processingFeeEnabled   Boolean @default(true)
  processingFeeOverrides Json? // partial Record<PaymentMethod, { percent, flat }>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_finance_settings")
}

/// Printed/digital receipt branding + WhatsApp auto-send config. Only holds
/// what isn't already on Storefront (tagline/logoUrl/instagramUrl/tiktokUrl —
/// reused directly from there when a store has a published storefront; a
/// cash-only store with no storefront simply omits those lines on its
/// receipt instead of duplicating the same fields here).
model StoreReceiptSettings {
  id      String @id @default(cuid())
  storeId String @unique

  footerMessage String?
  facebookUrl   String?
  showSocialLinks Boolean @default(true)
  // Per-store opt-out for the automatic "receipt sent via WhatsApp once
  // paymentStatus flips to PAID" flow — see send-customer-receipt.ts.
  autoSendWhatsappReceipt Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_receipt_settings")
}

/// Shared fees & taxes config for a Business, used by any Store with
/// syncFinanceWithBusiness = true (the "one integrated tax config across all
/// stores" option — see StoreFinanceSettings for the per-store equivalent).
model BusinessFinanceSettings {
  id         String @id @default(cuid())
  businessId String @unique

  taxEnabled   Boolean @default(false)
  taxRate      Decimal @default(0) @db.Decimal(6, 4) // 0.1100 = 11%
  taxLabel     String?
  taxInclusive Boolean @default(true)

  serviceChargeEnabled Boolean @default(false)
  serviceChargeRate    Decimal @default(0) @db.Decimal(6, 4)

  processingFeeEnabled   Boolean @default(true)
  processingFeeOverrides Json? // partial Record<PaymentMethod, { percent, flat }>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_finance_settings")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Product {
  id                String               @id @default(cuid())
  sku               String
  name              String
  description       String?
  category          String?
  department        Department           @default(KITCHEN)
  costPrice         Decimal              @db.Decimal(10, 2)
  sellingPrice      Decimal              @db.Decimal(10, 2)
  currentStock      Decimal              @default(0) @db.Decimal(10, 3)
  unit              String               @default("piece")
  productionTime    Int?
  shelfLife         Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  storeId           String
  maxStock          Decimal              @default(1000) @db.Decimal(10, 3)
  minStock          Decimal              @default(0) @db.Decimal(10, 3)
  orderItems        OrderItem[]
  productionBatches ProductionBatch[]
  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipeProducts    RecipeProduct[]
  stockMovements    StockMovement[]
  menuItems         MenuItem[]
  optionGroups      ProductOptionGroup[]
  wasteEntries      WasteEntry[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([category])
  @@index([department])
  @@map("products")
}

// A named group of selectable variants for a Product, e.g. "Size" or "Sugar
// Level". Mirrors MenuItem.modifiers' shape (isRequired/maxSelections) but is
// relational (not JSON) so each option can optionally link to a Material with
// a custom stock-deduction quantity — see ProductOption.
model ProductOptionGroup {
  id            String          @id @default(cuid())
  productId     String
  name          String
  isRequired    Boolean         @default(false)
  maxSelections Int             @default(1)
  displayOrder  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options       ProductOption[]

  @@index([productId])
  @@map("product_option_groups")
}

model ProductOption {
  id              String             @id @default(cuid())
  groupId         String
  name            String
  priceAdjustment Decimal            @default(0) @db.Decimal(10, 2)
  // Optional stock linkage: choosing this option additionally consumes
  // `materialQty` units (in the material's own unit) of `materialId` per
  // unit sold, on top of whatever the product's recipe already consumes.
  // Null materialId = price-only option, no stock impact.
  materialId      String?
  materialQty     Decimal?           @db.Decimal(10, 3)
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  group           ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  material        Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([materialId])
  @@map("product_options")
}

model Material {
  id                 String              @id @default(cuid())
  sku                String
  name               String
  description        String?
  category           String?
  department         Department          @default(BOTH)
  unit               String              @default("kg")
  // Cost per one `unit`, derived server-side as purchasePrice ÷ purchaseQuantity
  // rather than typed directly — see CreateMaterialInput. Needs more than 2
  // decimal places (e.g. a €2, 1000g pack of flour is €0.002/g).
  unitCost           Decimal             @db.Decimal(14, 6)
  // How many `unit`s come in one purchase pack (e.g. 1000 if unit="g" and you
  // buy 1kg bags) — lets the Add/Edit Material form show "Purchase Price" the
  // way it's actually bought, and reconstruct it on edit as unitCost × this.
  purchaseQuantity   Decimal             @default(1) @db.Decimal(10, 3)
  currentStock       Decimal             @default(0) @db.Decimal(10, 3)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  maxStock           Decimal             @default(1000) @db.Decimal(10, 3)
  minStock           Decimal             @default(0) @db.Decimal(10, 3)
  // Single next-expiration date for this material's current stock. Not
  // per-batch/lot — if a store receives multiple deliveries with different
  // expiration dates, this holds whichever date the owner has set most
  // recently (typically the soonest-expiring one they want to track).
  expirationDate     DateTime?
  storeId            String
  materialSuppliers  MaterialSupplier[]  @relation("MaterialToSuppliers")
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recipeIngredients  RecipeIngredient[]
  stockMovements     StockMovement[]
  supplierOrderItems SupplierOrderItem[]
  productOptions     ProductOption[]
  wasteEntries       WasteEntry[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([category])
  @@index([department])
  @@map("ingredients")
}

model MaterialSupplier {
  id               String   @id @default(cuid())
  supplierId       String
  // Cost per one Material.unit from this supplier, derived server-side the
  // same way as Material.unitCost (see purchaseQuantity below).
  price            Decimal  @db.Decimal(14, 6)
  // How many Material.unit`s come in one pack this supplier sells, e.g. 1000
  // if the material's unit is "g" and this supplier sells 1kg bags.
  purchaseQuantity Decimal  @default(1) @db.Decimal(10, 3)
  isPreferred      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  materialId       String
  material         Material @relation("MaterialToSuppliers", fields: [materialId], references: [id], onDelete: Cascade)
  supplier         Supplier @relation("SupplierToMaterials", fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([materialId, supplierId])
  @@index([materialId])
  @@index([supplierId])
  @@map("ingredient_suppliers")
}

model Recipe {
  id                    String             @id @default(cuid())
  instructions          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  storeId               String
  category              String?
  department            Department         @default(KITCHEN)
  costPerBatch          Decimal            @default(0) @db.Decimal(10, 2)
  description           String?
  name                  String
  productionTimeMinutes Int
  yieldQuantity         Decimal            @db.Decimal(10, 3)
  yieldUnit             String
  productionBatches     ProductionBatch[]
  ingredients           RecipeIngredient[]
  recipeProducts        RecipeProduct[]
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([category])
  @@index([department])
  @@map("recipes")
}

model RecipeIngredient {
  id         String   @id @default(cuid())
  recipeId   String
  quantity   Decimal  @db.Decimal(10, 3)
  unit       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  notes      String?
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, materialId])
  @@map("recipe_ingredients")
}

model RecipeProduct {
  id        String   @id @default(cuid())
  recipeId  String
  productId String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, productId])
  @@index([recipeId])
  @@index([productId])
  @@map("recipe_products")
}

model ProductionBatch {
  id              String                @id @default(cuid())
  batchNumber     String                @unique
  productId       String
  recipeId        String?
  plannedQuantity Decimal               @db.Decimal(10, 3)
  actualQuantity  Decimal?              @db.Decimal(10, 3)
  unit            String
  status          ProductionStatus      @default(PLANNED)
  // MANUAL = staff proactively started this (the original flow, unchanged).
  // ORDER_SHORTFALL = auto-drafted by stock-deduction.service.ts when an
  // order needed more of a recipe-linked product than was on hand. These
  // never move stock themselves (see completeProduction) — they're a task
  // record proving a human still needs to physically make the shortfall,
  // and their completion is what flips the linked OrderItem(s) to READY.
  triggerType     ProductionTriggerType @default(MANUAL)
  scheduledDate   DateTime
  completedDate   DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  storeId         String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe          Recipe?               @relation(fields: [recipeId], references: [id])
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  stockMovements  StockMovement[]
  orderItems      OrderItem[]

  @@index([storeId])
  @@index([productId])
  @@index([status])
  @@index([scheduledDate])
  @@map("production_batches")
}

model StockMovement {
  id                String           @id @default(cuid())
  productId         String?
  type              MovementType
  quantity          Decimal          @db.Decimal(10, 3)
  unit              String
  balanceAfter      Decimal          @db.Decimal(10, 3)
  orderId           String?
  productionBatchId String?
  notes             String?
  createdAt         DateTime         @default(now())
  materialId        String?
  reason            String?
  referenceId       String?
  // Links this movement back to the WasteEntry that produced it — the
  // original WASTE-type movement at creation, plus any later compensating
  // ADJUSTMENT movement from an edit/delete correction (see WasteEntry).
  // One-to-many: a single WasteEntry can accumulate several movements over
  // its life as it's corrected, so this is never unique.
  wasteEntryId      String?
  material          Material?        @relation(fields: [materialId], references: [id], onDelete: Cascade)
  order             Order?           @relation(fields: [orderId], references: [id])
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productionBatch   ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  wasteEntry        WasteEntry?      @relation(fields: [wasteEntryId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([materialId])
  @@index([type])
  @@index([createdAt])
  @@index([wasteEntryId])
  @@map("stock_movements")
}

// A staff-recorded loss of a Material (raw ingredient) or Product (finished
// good) — expired, damaged, spoiled, etc. Unlike StockMovement (an
// append-only audit ledger), WasteEntry is mutable: corrections update this
// row directly and, when the correction changes quantity/cost, append a new
// compensating StockMovement rather than rewriting the original one. See
// WasteService for the reconciliation logic.
model WasteEntry {
  id               String          @id @default(cuid())
  storeId          String
  materialId       String?
  productId        String?
  quantity         Decimal         @db.Decimal(10, 3)
  unit             String
  reason           WasteReason
  // Free-text detail. Required (enforced at the validation layer) when
  // reason = OTHER; optional supplementary detail otherwise.
  customReason     String?
  notes            String?
  // Cost per unit frozen at record time (or explicitly overridden on a later
  // edit) — never re-derived from the item's live cost, so historical loss
  // value stays stable even if ingredient prices change afterward.
  unitCostSnapshot Decimal         @db.Decimal(14, 6)
  // quantity * unitCostSnapshot, stored (not computed on read) so an edit's
  // manual override is preserved exactly as entered.
  totalValue       Decimal         @db.Decimal(12, 2)
  referenceId      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  material         Material?       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements   StockMovement[]

  @@index([storeId])
  @@index([materialId])
  @@index([productId])
  @@index([reason])
  @@index([createdAt])
  @@map("waste_entries")
}

model Supplier {
  id                String             @id @default(cuid())
  name              String
  contactPerson     String?
  email             String?
  phone             String?
  address           String?
  city              String?
  country           String?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  storeId           String
  materialSuppliers MaterialSupplier[] @relation("SupplierToMaterials")
  supplierOrders    SupplierOrder[]
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("suppliers")
}

model SupplierOrder {
  id           String              @id @default(cuid())
  storeId      String
  supplierId   String
  orderNumber  String              @unique
  status       SupplierOrderStatus @default(PENDING)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  subtotal     Decimal             @db.Decimal(10, 2)
  tax          Decimal             @default(0) @db.Decimal(10, 2)
  shipping     Decimal             @default(0) @db.Decimal(10, 2)
  total        Decimal             @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        SupplierOrderItem[]
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id         String        @id @default(cuid())
  orderId    String
  materialId String
  quantity   Decimal       @db.Decimal(10, 3)
  unit       String
  unitPrice  Decimal       @db.Decimal(10, 2)
  total      Decimal       @db.Decimal(10, 2)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  material   Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  order      SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([materialId])
  @@map("supplier_order_items")
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique
  customerName       String
  customerEmail      String?
  customerPhone      String?
  deliveryAddress    String?
  status             OrderStatus     @default(PENDING)
  orderDate          DateTime        @default(now())
  dueDate            DateTime?
  deliveredDate      DateTime?
  subtotal           Decimal         @db.Decimal(10, 2)
  tax                Decimal         @default(0) @db.Decimal(10, 2)
  delivery           Decimal         @default(0) @db.Decimal(10, 2)
  total              Decimal         @db.Decimal(10, 2)
  // Phase 5: fees & taxes — amounts are frozen at order-creation/finalize time
  // (not recomputed from current store settings), so editing a store's rates
  // later never rewrites the numbers on past orders. taxRate/serviceChargeRate/
  // processingFeeRate are the audit trail — the rate that produced the amount.
  serviceCharge      Decimal         @default(0) @db.Decimal(10, 2)
  processingFee      Decimal         @default(0) @db.Decimal(10, 2)
  taxRate            Decimal         @default(0) @db.Decimal(6, 4)
  serviceChargeRate  Decimal         @default(0) @db.Decimal(6, 4)
  processingFeeRate  Decimal         @default(0) @db.Decimal(6, 4)
  // Discount applied at checkout, frozen the same way as the charges above —
  // subtracted from subtotal before tax/service-charge are computed. See
  // computeOrderCharges() in src/lib/finance/order-charges.ts.
  discountAmount     Decimal         @default(0) @db.Decimal(10, 2)
  discountReason     String?
  // Staff-initiated refund (POS order history "Issue Refund" action) — never
  // written automatically. Does not reverse stock: in F&B a refund does not
  // mean the food returns to inventory.
  refundAmount       Decimal         @default(0) @db.Decimal(10, 2)
  refundedAt         DateTime?
  refundReason       String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  storeId            String
  // Phase 2 fields
  storefrontId       String?
  orderType          OrderType       @default(DINE_IN)
  tableNumber        String?
  paymentMethod      PaymentMethod   @default(CASH)
  paymentStatus      PaymentStatus   @default(PENDING)
  paymentProviderRef String?
  paymentQrString    String?         @db.Text
  // Optional free-text note recorded when manually settling a PENDING order
  // via "Mark as Paid" (e.g. "client paid directly to the owner") — distinct
  // from the order-level `notes` field, which is customer/checkout notes.
  paymentNote        String?
  source             OrderSource     @default(MANUAL)
  // Phase 3 fields
  tableId            String?
  // Phase 4 fields
  shiftId            String?
  items              OrderItem[]
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storefront         Storefront?     @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  table              Table?          @relation(fields: [tableId], references: [id], onDelete: SetNull)
  shift              Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  stockMovements     StockMovement[]
  receiptSends       OrderReceiptSend[]

  @@index([storeId])
  @@index([status])
  @@index([orderDate])
  @@index([dueDate])
  @@index([storefrontId])
  @@index([paymentStatus])
  @@index([tableId])
  @@index([shiftId])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String?
  menuItemId      String?
  name            String          @default("")
  quantity        Decimal         @db.Decimal(10, 2)
  unit            String
  unitPrice       Decimal         @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  // Free-text instruction for this line (e.g. "no ice"), separate from the
  // order-level Order.notes.
  notes           String?
  // Frozen snapshot of the chosen modifiers/options at order time —
  // [{groupName, optionName, priceAdjustment, materialId?, materialQty?}].
  // Snapshotted (not a live relation) so edits/deletes to the source
  // MenuItem.modifiers or ProductOption rows never rewrite past orders, and
  // so stock-deduction has a stable record of exactly what extra material to
  // subtract even if the option is later changed.
  selectedOptions Json?
  // Frozen Material.unitCost at the moment deductStockForOrder() recorded this
  // item's SALE StockMovement — same idea as WasteEntry.unitCostSnapshot, so
  // historical COGS/margin reports don't silently drift if ingredient prices
  // change later. Null for legacy rows and for items with no COGS
  // attribution path (aggregator items with only menuItemId, no productId).
  unitCostSnapshot Decimal?        @db.Decimal(14, 6)
  // Phase 3: KDS workflow
  status          OrderItemStatus @default(PENDING)
  preparedAt      DateTime?
  servedAt        DateTime?
  // Set when this line triggered (or was folded into) an auto-drafted
  // ORDER_SHORTFALL ProductionBatch — see ProductionBatch.triggerType and
  // stock-deduction.service.ts. Completing that batch flips this item to
  // READY, so the kitchen's "done" tap and the batch's completion are the
  // same real-world event instead of two disconnected systems.
  productionBatchId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  menuItem        MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  productionBatch ProductionBatch? @relation(fields: [productionBatchId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([menuItemId])
  @@index([status])
  @@index([productionBatchId])
  @@map("order_items")
}

/// Audit trail for the customer-facing digital receipt (WhatsApp link to
/// /r/[orderId]) — one row per send attempt, whether it succeeded or not.
/// Lets order history show "already sent"/"failed" instead of a bare button,
/// and lets a merchant retry a FAILED send. See send-customer-receipt.ts.
model OrderReceiptSend {
  id              String                 @id @default(cuid())
  orderId         String
  channel         String                 @default("WHATSAPP")
  recipientPhone  String
  status          OrderReceiptSendStatus
  fonnteMessageId String?
  errorMessage    String?
  sentAt          DateTime               @default(now())
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_receipt_sends")
}

enum OrderReceiptSendStatus {
  SENT
  FAILED
}

