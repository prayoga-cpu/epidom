// PHASE 1 -- Public Storefront
model Storefront {
  id           String  @id @default(cuid())
  storeId      String  @unique
  slug         String  @unique
  displayName  String
  tagline      String?
  description  String?
  logoUrl      String?
  heroImageUrl String?
  themeColor   String  @default("#FF6B35")
  fontFamily   String  @default("Inter")

  whatsappNumber String?
  instagramUrl   String?
  tiktokUrl      String?
  gofoodUrl      String?
  grabfoodUrl    String?
  shopeefoodUrl  String?
  googleMapsUrl  String?
  customLinks    Json?

  isPublished         Boolean @default(false)
  acceptsOrders       Boolean @default(false)
  acceptsReservations Boolean @default(false)
  openingHours        Json?
  viewCount           Int     @default(0)

  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  events         StorefrontEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("storefronts")
}

enum StorefrontEventType {
  VIEW // storefront profile page load
  MENU_VIEW // /[slug]/menu page load
  ITEM_VIEW // /[slug]/menu/[itemId] page load
  WHATSAPP_CLICK // click on the WhatsApp/"chat" CTA
}

model StorefrontEvent {
  id           String              @id @default(cuid())
  storefrontId String
  type         StorefrontEventType
  // Loose reference + frozen snapshot, same convention as OrderItem.name —
  // survives the menu item being renamed/deleted later.
  menuItemId   String?
  menuItemName String?
  // Daily-rotating anonymous fingerprint: sha256(ip:userAgent:dateUTC:storefrontId).
  // Never stores raw IP. Rotating daily is a deliberate privacy trade-off (no
  // persistent cross-day identifier, no cookie/consent flow needed) — "unique
  // visitors" over a range is a sum of daily-uniques, the standard DAU-style
  // approximation, not a lifetime-unique count.
  visitorHash String
  referrer    String?
  createdAt   DateTime @default(now())

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@index([storefrontId, type, createdAt])
  @@index([storefrontId, visitorHash, createdAt])
  @@map("storefront_events")
}

model MenuCategory {
  id           String @id @default(cuid())
  storefrontId String
  name         String
  displayOrder Int    @default(0)

  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id           String     @id @default(cuid())
  storefrontId String
  categoryId   String?
  productId    String? // optional link to Product for inventory deduction
  department   Department @default(KITCHEN) // synced from the linked Product on create/update; settable directly otherwise
  name         String
  description  String?
  price        Decimal    @db.Decimal(12, 2)
  currency     String     @default("IDR")
  imageUrl     String?
  isAvailable  Boolean    @default(true)
  isFeatured   Boolean    @default(false)
  displayOrder Int        @default(0)
  modifiers    Json? // [{name, options: [{name, priceAdd}]}]

  storefront Storefront    @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([storefrontId])
  @@index([department])
  @@map("menu_items")
}

/// One row per nightly logical-backup run (see src/lib/backup/). Not tenant-scoped —
/// this is platform-operational metadata, not customer data.
model BackupRun {
  id           String          @id @default(cuid())
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  status       BackupRunStatus @default(RUNNING)
  tableCount   Int             @default(0)
  totalRows    Int             @default(0)
  totalBytes   BigInt          @default(0)
  errorMessage String?

  @@index([status, startedAt])
  @@map("backup_runs")
}

enum BackupRunStatus {
  RUNNING
  SUCCESS
  FAILED
}
