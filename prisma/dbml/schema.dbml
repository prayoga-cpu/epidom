  updatedAt DateTime [not null]
}

Table storefronts {
  id String [pk]
  storeId String [unique, not null]
  slug String [unique, not null]
  displayName String [not null]
  tagline String
  description String
  logoUrl String
  heroImageUrl String
  themeColor String [not null, default: '#FF6B35']
  fontFamily String [not null, default: 'Inter']
  whatsappNumber String
  instagramUrl String
  tiktokUrl String
  gofoodUrl String
  grabfoodUrl String
  shopeefoodUrl String
  googleMapsUrl String
  customLinks Json
  isPublished Boolean [not null, default: false]
  acceptsOrders Boolean [not null, default: false]
  acceptsReservations Boolean [not null, default: false]
  openingHours Json
  viewCount Int [not null, default: 0]
  store stores [not null]
  menuCategories menu_categories [not null]
  menuItems menu_items [not null]
  orders orders [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table menu_categories {
  id String [pk]
  storefrontId String [not null]
  name String [not null]
  displayOrder Int [not null, default: 0]
  storefront storefronts [not null]
  items menu_items [not null]
}

Table menu_items {
  id String [pk]
  storefrontId String [not null]
  categoryId String
  productId String
  department Department [not null, default: 'KITCHEN']
  name String [not null]
  description String
  price Decimal [not null]
  currency String [not null, default: 'IDR']
  imageUrl String
  isAvailable Boolean [not null, default: true]
  isFeatured Boolean [not null, default: false]
  displayOrder Int [not null, default: 0]
  modifiers Json
  storefront storefronts [not null]
  category menu_categories
  product products
  orderItems order_items [not null]
}

